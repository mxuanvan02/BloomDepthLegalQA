# Copy these values into a Colab cell or Colab Secrets.
# Do not commit real tokens.

BLOOMDEPTH_ROOT=/content/BloomDepth
BLOOMDEPTH_DRIVE=/content/drive/MyDrive/BloomDepth_Backup
HF_HOME=/content/drive/MyDrive/BloomDepth_Backup/hf_cache
TRANSFORMERS_CACHE=/content/drive/MyDrive/BloomDepth_Backup/hf_cache
HUGGINGFACE_HUB_CACHE=/content/drive/MyDrive/BloomDepth_Backup/hf_cache

# Optional, required for gated Hugging Face models.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Runtime tuning for Colab L4/A100.
DOCLING_DEVICE=auto
DOCLING_NUM_THREADS=8
DOCLING_EXTRACT_WORKERS=2
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
